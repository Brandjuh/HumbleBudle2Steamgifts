{
  "manifest_version": 3,
  "name": "Humble → SteamGifts",
  "version": "0.1.0",
  "description": "Maak van Humble Choice-keys met een paar klikken SteamGifts-giveaways.",
  "minimum_chrome_version": "116",

  "permissions": ["storage", "sidePanel"],

  "host_permissions": [
    "https://www.humblebundle.com/*",
    "https://www.steamgifts.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "action": {
    "default_title": "Humble → SteamGifts",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.humblebundle.com/membership/*",
        "https://www.humblebundle.com/subscription/*",
        "https://www.humblebundle.com/home/keys*",
        "https://www.humblebundle.com/downloads*"
      ],
      "js": [
        "lib/shared.js",
        "lib/dom.js",
        "lib/selectors.js",
        "lib/format.js",
        "content/humble.js"
      ],
      "css": ["content/humble.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.steamgifts.com/giveaways/new*",
        "https://www.steamgifts.com/giveaway/*"
      ],
      "js": [
        "lib/shared.js",
        "lib/dom.js",
        "lib/selectors.js",
        "lib/format.js",
        "content/steamgifts.js"
      ],
      "css": ["content/steamgifts.css"],
      "run_at": "document_idle"
    }
  ]
}
